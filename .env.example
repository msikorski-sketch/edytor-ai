# Domeny narzędzia (rekordy A na IP serwera; Traefik pobierze certyfikaty) — używane w docker-compose.yml.
EDYTOR_DOMENA_PANELU=edytor.example.com
EDYTOR_DOMENA_PODGLADU=podglad.example.com
EDYTOR_DOMENA_STRON=strony.example.com
# Adresy IP serwera (IPv4 i IPv6, po przecinku): własna domena projektu działa, gdy jej DNS wskazuje tylko na nie.
EDYTOR_IP_SERWERA=203.0.113.10,2001:db8::10

# Hasło do panelu edytora.
EDYTOR_HASLO=
# Losowy sekret do podpisywania ciasteczek sesji: openssl rand -hex 32
EDYTOR_SEKRET=

# --- Wariant A: Claude przez API Anthropic (płatnie) ---
ANTHROPIC_API_KEY=
# EDYTOR_MODEL=claude-opus-5-5

# --- Wariant B: OpenRouter (np. darmowe modele :free) ---
# ANTHROPIC_BASE_URL=https://openrouter.ai/api
# ANTHROPIC_AUTH_TOKEN=sk-or-...
# ANTHROPIC_API_KEY=            # musi zostać PUSTY, inaczej SDK spróbuje logować się w Anthropic
# EDYTOR_MODEL=thinkingmachines/inkling:free
# Model zapasowy, gdy główny jest przeciążony:
# EDYTOR_MODEL_ZAPASOWY=nvidia/nemotron-3-ultra-550b-a55b:free
# Model do zadań pobocznych Claude Code (domyślnie Haiku, płatny) — ustaw darmowy:
# ANTHROPIC_DEFAULT_HAIKU_MODEL=thinkingmachines/inkling-small:free

# Limit czasu jednego polecenia w sekundach (domyślnie 600).
# EDYTOR_LIMIT_CZASU_S=600

# Ile razy agent ponawia nieudane zapytanie do modelu (domyślnie 2).
# CLAUDE_CODE_MAX_RETRIES=2
# Ilu agentów może pracować jednocześnie na serwerze (domyślnie 2).
# EDYTOR_MAX_AGENTOW=2

# --- Formularze na stronach: wysyłka powiadomień e-mail (opcjonalnie) ---
# Adres serwera SMTP z loginem i hasłem, np. smtps://strona%40twojadomena.pl:HASLO@smtp.twojadomena.pl:465
# (znaki specjalne w loginie/haśle zakoduj: @ → %40). Bez tego zgłoszenia są zapisywane i wysyłane tylko webhookiem.
# EDYTOR_SMTP=
# Nadawca wiadomości (adres w domenie, z której wolno wysyłać przez ten SMTP):
# EDYTOR_SMTP_OD=strona@twojadomena.pl

# Alerty (dysk < 10% wolnego, nieudana lub stara kopia, 3 błędy asystenta z rzędu) jako POST z tekstem,
# np. https://ntfy.sh/<twoj-tajny-temat> albo webhook n8n. Pusty = tylko wpis w logach.
# EDYTOR_ALERT_WEBHOOK=
# EDYTOR_ALERT_MIEJSCE_PROCENT=10
